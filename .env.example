# Copy this file to `.env` for local development, and never commit that file.

# --- Database ---
MYSQL_ROOT_PASSWORD=restaurant-root
MYSQL_DATABASE=restaurant
MYSQL_USER=restaurant
MYSQL_PASSWORD=restaurant
MYSQL_PORT=3306
DATABASE_URL=mysql+asyncmy://restaurant:restaurant@localhost:3306/restaurant?charset=utf8mb4

# --- API ---
ENVIRONMENT=local
JWT_SECRET=dev-only-secret-replace-me-0123456789
ACCESS_TOKEN_TTL_MINUTES=480
CORS_ORIGINS=["http://localhost:3000"]

# --- AI Assistant ---
# Primary provider is DeepSeek's OpenAI-compatible commercial API
# (https://api-docs.deepseek.com/); `ollama` is the self-hosted fallback used as
# configuration C in the evaluation when no commercial key is available.
AI_PROVIDER=deepseek
AI_API_KEY=
LLM_MODEL=deepseek-flash
LLM_BASE_URL=https://api.deepseek.com
# Runtime fallback (report §1.4.2, §4.1.1): used only when the primary model call
# fails (transport error, timeout, 429 or 5xx), never on a 4xx auth/validation error.
LLM_FALLBACK_MODEL=deepseek-v4-pro
AI_OLLAMA_BASE_URL=http://localhost:11434
# Configuration C of the A/B/C experiment: configuration B run on a second model.
AI_CONFIG_C_MODEL=deepseek-v4-pro
AI_MAX_ROWS=500
AI_RESPONSE_BUDGET_SECONDS=8
AI_DAILY_QUESTION_QUOTA=50
# NFR-06 execution limits.
AI_SQL_TIMEOUT_SECONDS=3
AI_MAX_SQL_ATTEMPTS=2
AI_SQL_CACHE_TTL_SECONDS=300
# NFR-06: one read-only account per role, each granted SELECT on that role's view
# only. Leave blank locally to fall back to the main account during development.
AI_READONLY_URL_MANAGER=
AI_READONLY_URL_CASHIER=
AI_READONLY_URL_WAREHOUSE=

# --- Web ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_PREFIX=/api/v1

# --- Payment gateway ---
# simulator: QR mock cho demo/test, không nhận tiền thật.
# sepay: VietQR thật + webhook tự xác nhận khi tiền vào tài khoản ngân hàng.
PAYMENT_GATEWAY=simulator
SEPAY_BANK_ACCOUNT=
SEPAY_BANK_CODE=
SEPAY_ACCOUNT_NAME=
SEPAY_WEBHOOK_API_KEY=
SEPAY_API_TOKEN=
SEPAY_PAYMENT_PREFIX=TT
# Dùng cho webhook giả lập; bỏ trống ở môi trường thật.
PAYMENT_WEBHOOK_SECRET=
