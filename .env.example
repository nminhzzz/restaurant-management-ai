# Copy this file to `.env` for local development, and never commit that file.

# --- Database ---
MYSQL_ROOT_PASSWORD=restaurant-root
MYSQL_DATABASE=restaurant
MYSQL_USER=restaurant
MYSQL_PASSWORD=restaurant
MYSQL_PORT=3306
DATABASE_URL=mysql+asyncmy://restaurant:restaurant@localhost:3306/restaurant?charset=utf8mb4

# --- API ---
ENVIRONMENT=local
JWT_SECRET=dev-only-secret-replace-me-0123456789
ACCESS_TOKEN_TTL_MINUTES=480
CORS_ORIGINS=["http://localhost:3000"]

# --- AI Assistant ---
# The default provider is the DeepSeek commercial API (OpenAI-compatible). `openai`
# selects the OpenAI endpoint, `ollama` the self-hosted fallback, `fake` a fixed reply
# for running without any provider.
AI_PROVIDER=deepseek
AI_API_KEY=
LLM_MODEL=deepseek-flash
# Empty = the provider's default endpoint (https://api.deepseek.com for deepseek).
LLM_BASE_URL=
# Runtime fallback: used once when the primary model fails (transport error, timeout,
# 429 or 5xx). Empty = AI_CONFIG_C_MODEL.
LLM_FALLBACK_MODEL=
# Sent only when AI_PROVIDER=deepseek; empty = send nothing. "low" keeps two LLM calls
# per question inside the response budget.
LLM_REASONING_EFFORT=low
# Configuration C of the A/B/C experiment runs configuration B on this second model
# (a reasoning model, e.g. deepseek-v4-pro); also the fallback model when
# LLM_FALLBACK_MODEL is empty.
AI_CONFIG_C_MODEL=
AI_OLLAMA_BASE_URL=http://localhost:11434
# NFR-02: the whole question must finish inside this budget (seconds) or the turn ends
# with a timeout message.
AI_RESPONSE_BUDGET_SECONDS=8
AI_MAX_ROWS=500
# NFR-06 execution limits.
AI_SQL_TIMEOUT_SECONDS=3
AI_MAX_SQL_ATTEMPTS=2
# The per-user daily question quota is NOT an environment variable: it is the system
# setting SoCauHoiAIMoiNgay (FR-SET-04, default 50), edited in the Settings screen.
# NFR-06: one read-only account per role, each granted SELECT on that role's view
# only (db/views/README.md). All three are required to use the assistant; a blank URL
# makes that role's questions fail closed, there is no fallback to the main account.
AI_READONLY_URL_MANAGER=
AI_READONLY_URL_CASHIER=
AI_READONLY_URL_WAREHOUSE=

# --- Payments ---
# HMAC secret of the simulator webhook; required when ENVIRONMENT is not `local`. The
# simulator route itself only exists when ENVIRONMENT=local and PAYMENT_GATEWAY=simulator.
PAYMENT_WEBHOOK_SECRET=
# `simulator` (default, tests/local) or `sepay` (real bank-transfer QR).
PAYMENT_GATEWAY=simulator
# Required when PAYMENT_GATEWAY=sepay: SEPAY_BANK_ACCOUNT, SEPAY_BANK_CODE and
# SEPAY_WEBHOOK_API_KEY (the API key SePay sends on each webhook call).
SEPAY_BANK_ACCOUNT=
SEPAY_BANK_CODE=
SEPAY_ACCOUNT_NAME=
SEPAY_WEBHOOK_API_KEY=
# Token for SePay's user API; enables the "check payment" lookup of recent transfers.
# Optional: leave blank to rely on the webhook alone.
SEPAY_API_TOKEN=
SEPAY_PAYMENT_PREFIX=TT
SEPAY_API_URL=https://my.sepay.vn/userapi

# --- Web ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_PREFIX=/api/v1
