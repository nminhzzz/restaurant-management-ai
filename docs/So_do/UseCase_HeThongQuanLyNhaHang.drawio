  <diagram id="p1" name="01 Quản lý danh mục">
    <mxGraphModel dx="1256" dy="763" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="p10"/>
        <mxCell id="p11" parent="p10"/>
        <mxCell id="p1b1" parent="p11" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontSize=14;fillColor=none;strokeWidth=2;" value="QUẢN LÝ DANH MỤC" vertex="1">
          <mxGeometry height="645" width="370" x="235" y="75" as="geometry"/>
        </mxCell>
        <object label="1.1&lt;br&gt;Quản lý nhóm món" id="p1u2" tooltip="Thêm, sửa, sắp xếp thứ tự hiển thị và xóa nhóm món; nhóm còn món chưa xóa mềm thì không được xóa.">
          <mxCell parent="p11" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1">
            <mxGeometry height="58" width="300" x="270" y="130" as="geometry"/>
          </mxCell>
        </object>
        <object label="1.2&lt;br&gt;Quản lý món ăn" tooltip="Tạo món (trạng thái Nháp đến khi có công thức đầu tiên), cập nhật thông tin, tạm dừng/mở lại phục vụ và xóa mềm món." id="p1u3">
          <mxCell parent="p11" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1">
            <mxGeometry height="58" width="300" x="270" y="212" as="geometry"/>
          </mxCell>
        </object>
        <object label="1.3&lt;br&gt;Quản lý công thức" tooltip="Khai báo nguyên liệu và định lượng theo đơn vị chuẩn; công thức đầu tiên có hiệu lực ngay, thay đổi sau được lên lịch theo Business Date tương lai." id="p1u4">
          <mxCell parent="p11" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1">
            <mxGeometry height="58" width="300" x="270" y="294" as="geometry"/>
          </mxCell>
        </object>
        <object label="1.4&lt;br&gt;Quản lý giá bán" tooltip="Nhập giá bán và ngày hiệu lực, hủy hoặc thay lịch giá trước hiệu lực; giá đã áp dụng được lưu lịch sử, không sửa dòng món cũ." id="p1u5">
          <mxCell parent="p11" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1">
            <mxGeometry height="58" width="300" x="270" y="376" as="geometry"/>
          </mxCell>
        </object>
        <object label="1.6&lt;br&gt;Quản lý nguyên liệu" id="p1u7" tooltip="Khai báo tên, đơn vị chuẩn và mức tồn tối thiểu; đơn vị tính bị khóa khi nguyên liệu đã được tham chiếu.">
          <mxCell parent="p11" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1">
            <mxGeometry height="58" width="300" x="270" y="540" as="geometry"/>
          </mxCell>
        </object>
        <object label="1.7&lt;br&gt;Quản lý nhà cung cấp" id="p1u8" tooltip="Thêm, sửa, xóa nhà cung cấp; xem thông tin liên hệ và lịch sử nhập hàng.">
          <mxCell parent="p11" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1">
            <mxGeometry height="58" width="300" x="270" y="622" as="geometry"/>
          </mxCell>
        </object>
        <object label="1.5&lt;br&gt;Quản lý bàn" id="p1u9" tooltip="Thêm, sửa, xóa bàn; bàn đang phục vụ không được xóa, bàn đã có lịch sử chỉ xóa mềm.">
          <mxCell parent="p11" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1">
            <mxGeometry height="58" width="300" x="270" y="458" as="geometry"/>
          </mxCell>
        </object>
        <mxCell id="p1a11" parent="p11" style="shape=umlActor;html=1;outlineConnect=0;fontSize=12;fontStyle=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;" value="Quản lý" vertex="1">
