  <diagram id="p2" name="02 Bán hàng">
    <mxGraphModel dx="1073" dy="652" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="p20"/>
        <mxCell id="p21" parent="p20"/>
        <mxCell id="p2b1" parent="p21" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontSize=14;fillColor=none;strokeWidth=2;" value="QUẢN LÝ BÁN HÀNG" vertex="1">
          <mxGeometry height="490" width="725" x="235" y="95" as="geometry"/>
        </mxCell>
        <object label="2.1&lt;br&gt;Gọi món tại chỗ" tooltip="Chọn bàn Trống, thêm món và gửi món; nguyên liệu được giữ theo lô FIFO, chỉ khi gửi món mới tạo order và chiếm bàn." id="p2u2">
          <mxCell parent="p21" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1">
            <mxGeometry height="58" width="280" x="265" y="150" as="geometry"/>
          </mxCell>
        </object>
        <object label="2.4&lt;br&gt;Thanh toán" tooltip="In phiếu tạm tính, chọn phương thức, ghi nhận thanh toán tiền mặt và phát hành hóa đơn." id="p2u8">
          <mxCell parent="p21" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1">
            <mxGeometry height="58" width="280" x="265" y="396" as="geometry"/>
          </mxCell>
        </object>
        <object label="2.8&lt;br&gt;Tra cứu order" tooltip="Quản lý truy cập mục Quản lý đơn hàng; xem danh sách, lọc mã, bàn, khoảng ngày kinh doanh và trạng thái; xem chi tiết món, thanh toán và in lại chứng từ. Thu ngân/Nhân viên order tra cứu theo quyền." id="p2u10">
          <mxCell parent="p21" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1">
            <mxGeometry height="58" width="280" x="265" y="478" as="geometry"/>
          </mxCell>
        </object>
        <object label="2.7&lt;br&gt;Hủy toàn bộ order" tooltip="Hủy order theo điều kiện nghiệp vụ, bắt buộc nhập lý do; hoàn nguyên liệu của món Chờ làm chưa chế biến." id="p2u11">
          <mxCell parent="p21" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1">
            <mxGeometry height="58" width="280" x="640" y="262" as="geometry"/>
          </mxCell>
        </object>
        <object label="2.5&lt;br&gt;Thanh toán QR" tooltip="Mở rộng UC 2.4: tạo mã QR hiệu lực 10 phút, nhận webhook từ cổng thanh toán, xử lý mã hết hạn hoặc quét lỗi." id="p2u13">
          <mxCell parent="p21" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1">
            <mxGeometry height="58" width="280" x="640" y="398" as="geometry"/>
          </mxCell>
        </object>
        <mxCell id="p2a15" parent="p21" style="shape=umlActor;html=1;outlineConnect=0;fontSize=12;fontStyle=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;" value="Thu ngân /&lt;br&gt;Nhân viên order" vertex="1">
          <mxGeometry height="80" width="40" x="140" y="303" as="geometry"/>
        </mxCell>
        <mxCell id="p2a16" parent="p21" style="shape=umlActor;html=1;outlineConnect=0;fontSize=12;fontStyle=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;" value="Quản lý" vertex="1">
          <mxGeometry height="80" width="40" x="1000" y="200" as="geometry"/>
        </mxCell>
        <mxCell id="p2a17" parent="p21" style="shape=umlActor;html=1;outlineConnect=0;fontSize=12;fontStyle=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;" value="Cổng thanh toán&lt;br&gt;(hệ thống ngoài)" vertex="1">
          <mxGeometry height="80" width="40" x="1000" y="385" as="geometry"/>
        </mxCell>
        <object label="2.6&lt;br&gt;Xử lý xác minh thanh toán&lt;br&gt;và khoản QR ngoại lệ" tooltip="Khi khách báo đã chuyển tiền nhưng chưa có webhook, Quản lý đối chiếu sao kê; xác nhận đã nhận tiền, mở lại thanh toán hoặc đóng order chưa thu được tiền. Xử lý khoản QR đến muộn, sai số tiền hoặc thu trùng: áp dụng khoản hợp lệ hoặc ghi nhận hoàn tiền, không cộng doanh thu hai lần." id="fix_uc_reconcile">
          <mxCell parent="p21" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1">
